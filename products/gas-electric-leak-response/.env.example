# =====================================================================
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Every value marked REQUIRED must be set for production mode.
# For a no-Esri smoke test run:  python -m gas_electric_response demo
# =====================================================================

# --- ArcGIS connection (REQUIRED) ------------------------------------
# ArcGIS Online: https://www.arcgis.com   (or https://<org>.maps.arcgis.com)
# ArcGIS Enterprise: https://<host>/portal
ARCGIS_PORTAL_URL=https://www.arcgis.com
# Option 1: a service account (named user) with edit rights to the layers below
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# Option 2: OAuth app credentials instead of username/password (leave Option 1 blank)
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=

# --- Layer URLs (REQUIRED). Each ends in /<layer index>, e.g. .../FeatureServer/0
# Source survey layer written by Survey123 / Field Maps
SURVEY_FEATURE_LAYER_URL=https://services.arcgis.com/<org>/arcgis/rest/services/<gas_leak_survey>/FeatureServer/0
# Output layers created by scripts/create_incident_service.py (points + plume polygons)
INCIDENT_LAYER_URL=https://services.arcgis.com/<org>/arcgis/rest/services/Active_Gas_Electric_Incidents/FeatureServer/0
PLUME_LAYER_URL=https://services.arcgis.com/<org>/arcgis/rest/services/Active_Gas_Electric_Incidents/FeatureServer/1
# Enterprise reference layers (field names/values are mapped in config/layer_schema.yaml)
ELECTRIC_ASSETS_LAYER_URL=
GAS_VALVES_LAYER_URL=
CRITICAL_FACILITIES_LAYER_URL=
# Optional: customer meters (point) layer, counted inside the plume for Report 2
CUSTOMER_METERS_LAYER_URL=
# Franchise-area polygon: either a feature layer URL or a local GeoJSON file (EPSG:4326)
FRANCHISE_LAYER_URL=
FRANCHISE_GEOJSON=
# Set to false ONLY for demos; production should always verify the franchise area
REQUIRE_FRANCHISE_CHECK=true

# --- Weather (NWS api.weather.gov; no key, but a contact User-Agent is required) ---
NWS_USER_AGENT=(your-utility-name gas-electric-response, gis-admin@example.com)

# --- 811 / excavation tickets (optional; see docs/excavation-811.md) ---
# one of: none | rest | layer
EXCAVATION_PROVIDER=none
EXCAVATION_REST_URL=
EXCAVATION_REST_API_KEY=
EXCAVATION_LAYER_URL=

# --- Shared-drive report locations (REQUIRED) -------------------------
# Windows UNC paths are fine on Windows hosts. On Linux/macOS use the mounted path.
REPORT_PATH_A=\\EnterpriseStorage\GasOperations\Field_Tickets_Archive
REPORT_PATH_B=\\EnterpriseStorage\Safety_Compliance\Joint_Hazard_Assessments

# Report layouts: Jinja2 HTML files. Copy a template, edit it, and point these at your copy. See docs/report-templates.md
TEMPLATE_DIR=./templates
REPORT_TEMPLATE_A=field_ticket.html
REPORT_TEMPLATE_B=risk_assessment.html
# true = maps and photos render as neutral placeholders (useful while designing a template)
REPORT_PLACEHOLDER_MEDIA=false
# Optional: add your own variables/tables to templates with a ReportData subclass, e.g. mypackage.reports:MyReportData
REPORT_DATA_CLASS=

# --- Email (REQUIRED for production) ----------------------------------
# smtp = send for real, file = write .eml files to EMAIL_OUTBOX_DIR (testing)
EMAIL_MODE=smtp
EMAIL_OUTBOX_DIR=./outbox
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=gas-electric-alerts@example.com
# Comma-separated lists
EOC_DISTRIBUTION=eoc@example.com
ELECTRIC_DISPATCH_DISTRIBUTION=electric-dispatch@example.com
FIRE_LIAISON_DISTRIBUTION=fire-liaison@example.com
GIS_ADMIN_EMAIL=gis-admin@example.com
DIRECTOR_GAS_OPERATIONS_EMAIL=gas-director@example.com
CHIEF_SAFETY_OFFICER_EMAIL=chief-safety@example.com

# --- Webhook receiver (REQUIRED if you use webhooks) -------------------
# Long random string (e.g. `python -c "import secrets;print(secrets.token_urlsafe(32))"`).
# Put it on the webhook URL: https://<your-host>/webhooks/survey123?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=
# Optional: also verify an HMAC-SHA256 signature header if your sender provides one
WEBHOOK_HMAC_SECRET=
WEBHOOK_HMAC_HEADER=X-Signature
STATE_DB_PATH=./state/processed.sqlite

# --- Behaviour ---------------------------------------------------------
LOCAL_TIMEZONE=America/Chicago
CONFIG_DIR=./config
LOG_LEVEL=INFO
